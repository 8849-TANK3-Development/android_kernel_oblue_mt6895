			reg = <0 0x14002000 0 0x1000>;
			interrupts = <GIC_SPI 302 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&mmsys0_config_clk CLK_MM0_DISP_OVL0>;
			mediatek,larb = <0xa4>;
			mediatek,smi-id = <0>;
			dma-ranges = <0x0 0x0 0x0 0x0 0x4 0x0>;

			iommus = <&{/soc/iommu@1e802000} &{/soc/syscon@1e100000} &{/soc/iommu@1e802000} &{/clocks/clk26m}>;
			interconnects = <&{/soc/interconnect} 0x40007 &{/soc/interconnect} 0x10000 &{/soc/interconnect} 0x40007 &{/soc/interconnect} 0x10000 &{/soc/interconnect} 0x40007 &{/soc/interconnect} 0x10000>;
			interconnect-names = "DDP_COMPONENT_OVL0_qos",
