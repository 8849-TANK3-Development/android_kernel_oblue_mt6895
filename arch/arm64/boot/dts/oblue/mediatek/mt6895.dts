			dma-ranges = <0x0 0x0 0x0 0x0 0x4 0x0>;
			iommus = <&{/soc/iommu@1e810000} &{/soc/dma-controller@11300800}>;
			interconnects = <&{/soc/interconnect} 0x40062 &{/soc/interconnect} 0x10001>;
			interconnect-names = "mml_dma";
			inlinerot = <0x100 0x101>;
		};

		mml_wrot1: mml_wrot1@1f810000 {
			compatible = "mediatek,mt6895-mml_wrot";
			reg = <0 0x1f810000 0 0x1000>;
			clocks = <&mdpsys1_config_clk CLK_MDP1_MDP_WROT1>;
			clock-names = "wrot1";
			mediatek,larb = <0xb7 0x3>;
			comp-ids = <MML_WROT1>;
			comp-names = "wrot1";
			event_sw_rst_done = /bits/ 16
				<CMDQ_EVENT_MDPSYS1_MDP_WROT1_SW_RST_DONE_ENG_EVENT>;
			event_frame_done = /bits/ 16
				<CMDQ_EVENT_MDPSYS1_MDP_WROT1_FRAME_DONE>;
			event_bufa = /bits/ 16 <CMDQ_SYNC_TOKEN_MML_BUFA>;
			event_bufb = /bits/ 16 <CMDQ_SYNC_TOKEN_MML_BUFB>;
			event_buf_next = /bits/ 16 <CMDQ_SYNC_TOKEN_MML_BUF_NEXT>;
			dma-ranges = <0x0 0x0 0x0 0x0 0x4 0x0>;
			iommus = <&{/soc/iommu@1e810000} &{/soc/syscon@10320000}>;
			interconnects = <&{/soc/interconnect} 0x40063 &{/soc/interconnect} 0x10001>;
			interconnect-names = "mml_dma";
			inlinerot = <0x100 0x101>;
		};

		mml_rsz2: mml_rsz2@1f813000 {
			compatible = "mediatek,mt6895-mml_rsz2";
			reg = <0 0x1f813000 0 0x1000>;
			clocks = <&mdpsys1_config_clk CLK_MDP1_MDP_RSZ2>;
			clock-names = "rsz2";
			comp-ids = <MML_RSZ2>;
			comp-names = "rsz2";
		};

		mml_rsz3: mml_rsz3@1f814000 {
			compatible = "mediatek,mt6895-mml_rsz3";
			reg = <0 0x1f814000 0 0x1000>;
			clocks = <&mdpsys1_config_clk CLK_MDP1_MDP_RSZ3>;
			clock-names = "rsz3";
			comp-ids = <MML_RSZ3>;
			comp-names = "rsz3";
		};

		mml_wrot2: mml_wrot2@1f815000 {
			compatible = "mediatek,mt6895-mml_wrot";
			reg = <0 0x1f815000 0 0x1000>;
			clocks = <&mdpsys1_config_clk CLK_MDP1_MDP_WROT2>;
			clock-names = "wrot2";
			mediatek,larb = <0xb7 0x7>;
			comp-ids = <MML_WROT2>;
			comp-names = "wrot2";
			event_sw_rst_done = /bits/ 16
				<CMDQ_EVENT_MDPSYS1_MDP_WROT2_SW_RST_DONE_ENG_EVENT>;
			event_frame_done = /bits/ 16
				<CMDQ_EVENT_MDPSYS1_MDP_WROT2_FRAME_DONE>;
			dma-ranges = <0x0 0x0 0x0 0x0 0x4 0x0>;
			iommus = <&{/soc/iommu@1e810000} &{/spmi@1c804000/pmic@4/mt6363-auxadc}>;
			interconnects = <&{/soc/interconnect} 0x40067 &{/soc/interconnect} 0x10001>;
			interconnect-names = "mml_dma";
		};

		mml_wrot3: mml_wrot3@1f816000 {
			compatible = "mediatek,mt6895-mml_wrot";
			reg = <0 0x1f816000 0 0x1000>;
			clocks = <&mdpsys1_config_clk CLK_MDP1_MDP_WROT3>;
			clock-names = "wrot3";
			mediatek,larb = <0xb7 0x8>;
			comp-ids = <MML_WROT3>;
			comp-names = "wrot3";
			event_sw_rst_done = /bits/ 16
				<CMDQ_EVENT_MDPSYS1_MDP_WROT3_SW_RST_DONE_ENG_EVENT>;
			event_frame_done = /bits/ 16
				<CMDQ_EVENT_MDPSYS1_MDP_WROT3_FRAME_DONE>;
			dma-ranges = <0x0 0x0 0x0 0x0 0x4 0x0>;
			iommus = <&{/soc/iommu@1e810000} &{/soc/apirq@11e50000}>;
			interconnects = <&{/soc/interconnect} 0x40068 &{/soc/interconnect} 0x10001>;
			interconnect-names = "mml_dma";
		};

		hre_top_mdpsys@1f817000 {
			compatible = "mediatek,hre_top_mdpsys";
			reg = <0 0x1f817000 0 0x1000>;
		};

		odm: odm {
			compatible = "simple-bus";
			/* reserved for overlay by odm */
		};

		ssusb: usb0@11201000 {
			compatible = "mediatek,mtu3", "mediatek,mt6895-mtu3";
			reg = <0 0x11201000 0 0x2e00>,
				<0 0x11203e00 0 0x0100>;
			reg-names = "mac", "ippc";
			vusb33-supply = <&{/spmi@1c804000/second_pmic@5/regulators/VUSB}>;
			interrupts = <GIC_SPI 128 IRQ_TYPE_LEVEL_HIGH 0>;
			phy-cells = <1>;
			phys = <&{/soc/usb-phy0@11e40000/usb2-phy0@11e40000} &{/soc/syscon@1f800000} &{/soc/usb-phy0@11e40000/usb3-phy0@11e43000} &{/soc/power-controller@1c001000}>;
			clocks = <&topckgen_clk CLK_TOP_USB_TOP_SEL>,
				<&topckgen_clk CLK_TOP_USB_XHCI_SEL>,
				<&pericfg_ao_clk CLK_PERAOP_1_USB_FRMC>;
			clock-names = "sys_ck", "host_ck", "frmcnt_ck";
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			dr_mode = "otg";
			maximum-speed = "high-speed";
			mediatek,force-vbus;
			mediatek,clk-mgr;
			mediatek,hw-req-ctrl;
			mediatek,noise-still-tr;
			mediatek,gen1-txdeemph;
			mediatek,syscon-wakeup = <&pericfg_ao_clk 0x200 103>;
			wakeup-source;
			usb-role-switch;
			cdp-block;
			port {
				mtu3_drd_switch: endpoint@0 {
					remote-endpoint = <&{/extcon_usb/port/endpoint@0}>;
				};
			};

			usb_host: xhci0@11200000 {
				compatible = "mediatek,mtk-xhci";
				reg = <0 0x11200000 0 0x1000>;
				reg-names = "mac";
				interrupts = <GIC_SPI 129 IRQ_TYPE_LEVEL_HIGH 0>;
				clocks = <&clk26m>;
				clock-names = "sys_ck";
				status = "okay";
			};
		};

		ssusb1: usb1@11211000 {
			compatible = "mediatek,mtu3";
			reg = <0 0x11211000 0 0x2e00>,
				<0 0x11213e00 0 0x0100>;
			reg-names = "mac", "ippc";
			vusb33-supply = <&{/spmi@1c804000/second_pmic@5/regulators/VUSB}>;
			interrupts = <GIC_SPI 700 IRQ_TYPE_LEVEL_HIGH 0>;
			phy-cells = <1>;
			phys = <&{/soc/usb-phy1@11e30000/usb2-phy1@11e30000} &{/soc/syscon@1f800000}>;
			clocks = <&topckgen_clk CLK_TOP_USB_TOP_SEL>,
				<&topckgen_clk CLK_TOP_USB_XHCI_SEL>,
				<&pericfg_ao_clk CLK_PERAOP_1_USB1P_FRMC>;
			clock-names = "sys_ck", "host_ck", "frmcnt_ck";
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			dr_mode = "otg";
			maximum-speed = "high-speed";
			mediatek,force-vbus;
			mediatek,clk-mgr;
			mediatek,hw-req-ctrl;
			mediatek,noise-still-tr;
			usb-role-switch;
			port {
				mtu3_drd_switch1: endpoint@0 {
					remote-endpoint = <&{/extcon_usb1/port/endpoint@0}>;
				};
			};

			usb_host1: xhci1@11210000 {
				compatible = "mediatek,mtk-xhci-p1";
				reg = <0 0x11210000 0 0x1000>;
				reg-names = "mac";
				interrupts = <GIC_SPI 699 IRQ_TYPE_LEVEL_HIGH 0>;
				clocks = <&clk26m>;
				clock-names = "sys_ck";
				status = "okay";
			};
		};

		u3phy: usb-phy0@11e40000 {
			compatible = "mediatek,xsphy";
			reg = <0 0x11e43000 0 0x200>;
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;

			u2port0: usb2-phy0@11e40000 {
				reg = <0 0x11e40000 0 0x400>;
				clocks = <&clk26m>;
				clock-names = "ref";
				#phy-cells = <1>;
				usb2jtag = <0x8c 0x2>;
				mediatek,efuse-intr = <0x26>;
				mediatek,eye-vrt = <2>;
				mediatek,eye-vrt-host = <0x2>;
				mediatek,discth= <0xb>;
				nvmem-cells = <&{/efuse@11f10000/u2_phy_data} &{/efuse@11f10000/u2_phy_data}>;
				nvmem-cell-masks = <0x3f 0xf00>;
				nvmem-cell-names = "intr_cal", "term_cal";
			};

			u3port0: usb3-phy0@11e43000 {
				reg = <0x0 0x11e43400 0x0 0x500 0x0 0x11203e00 0x0 0x100>;
				clocks = <&clk26m>;
				clock-names = "ref";
				#phy-cells = <1>;
			};
		};

		u3phy1: usb-phy1@11e30000 {
			compatible = "mediatek,xsphy";
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;

			u2port1: usb2-phy1@11e30000 {
				reg = <0 0x11e30000 0 0x400>;
				clocks = <&clk26m>;
				clock-names = "ref";
				#phy-cells = <1>;
				/*mediatek,efuse-intr = <0x26>;*/
				/*mediatek,eye-vrt = <2>;*/
				/*mediatek,eye-vrt-host = <2>;*/
				/*mediatek,discth= <0xb>;*/
				mediatek,eye-vrt = <0x2>;
				mediatek,discth = <0xb>;
				nvmem-cells = <&{/efuse@11f10000/u2_phy_data} &{/efuse@11f10000/u2_phy_data}>;
				nvmem-cell-masks = <0x1f8000 0x7800000>;
				nvmem-cell-names = "intr_cal", "term_cal";
				mediatek,efuse-intr = <&{/soc/syscon@1c013000}>;
				mediatek,eye-vrt-host = <0x2>;
			};
		};

		u3fpgaphy: usb-phy {
			compatible = "mediatek,fpga-u3phy";
			mediatek,ippc = <0x11203e00>;
			#address-cells = <2>;
			#size-cells = <2>;
			fpga_i2c_physical_base = <0x11d01000>;
			status = "disabled";

			u3fpgaport0: usb-phy@0 {
				chip-id= <0xa60931a>;
				port = <0>;
				pclk_phase = <23>;
				#phy-cells = <1>;
			};
		};

		usb_boost: usb_boost_manager {
			compatible = "mediatek,usb_boost", "mediatek,mt6895-usb_boost";
			interconnects = <&{/soc/dvfsrc@1c00f000} &{/soc/syscon@15330000} &{/soc/dvfsrc@1c00f000} 0x0>;
			interconnect-names = "icc-bw";
			required-opps = <&dvfsrc_freq_opp0>;
			small-core = <0x1312d0>;
		};

		rt-pd-manager {
			compatible = "mediatek,rt-pd-manager";
		};

		typec_mux_switch: typec_mux_switch {
			compatible = "mediatek,typec_mux_switch";
			status = "okay";
		};

		usb_dp_selector: usb_dp_selector@10005600 {
			compatible = "mediatek,usb_dp_selector";
			reg = <0 0x10005600 0 0x4>;
			reg-names = "usb_dp_reg";
			status = "okay";
		};

		mrdump_ext_rst: mrdump_ext_rst {
			compatible = "mediatek, mrdump_ext_rst-eint";
			mode = "IRQ";
			status = "okay";
		};

		mipi_tx_config0: mipi_tx_config@11f70000 {
			compatible = "mediatek,mipi_tx_config0",
				"mediatek,mt6895-mipi-tx";
			reg = <0 0x11f70000 0 0x1000>;
			clocks = <&clk26m>;
			#clock-cells = <0>;
			#phy-cells = <0>;
			clock-output-names = "mipi_tx0_pll";
		};
		apuart1: serial@11002000 {
			compatible = "mediatek,mt6577-uart";
			reg = <0x0 0x11002000 0x0 0x1000>;
			interrupts = <0x0 0x8e 0x4 0x0>;
			dmas = <&{/soc/dma-controller@11300800} &{/clocks/clk26m} &{/soc/dma-controller@11300800} &{/soc/syscon@1f800000}>;
			dma-names = "tx", "rx";
			clocks = <&{/clocks/clk26m} &{/soc/syscon@11036000} &{/interrupt-controller}>;
			clock-names = "baud", "bus";
		};
		regulator_vibrator: regulator_vibrator {
			compatible = "regulator-vibrator";
			label = "vibrator";
			min-volt = <0x2ab980>;
			max-volt = <0x3567e0>;
			vib-supply = <&{/spmi@1c804000/second_pmic@5/regulators/VIBR}>;
		};
		mtk_ssc: mtk_ssc@1c01f000 {
			compatible = "mediatek,ssc";
			safe-vlogic-uv = <0x927c0>;
		};
		ktf-mmdvfs-test {
			compatible = "mediatek,ktf-mmdvfs-test";
			interconnects = <&{/soc/interconnect} 0x4000c &{/soc/interconnect} 0x10000 &{/soc/interconnect} 0x4000c &{/soc/interconnect} 0x10000 &{/soc/interconnect} 0x4032b &{/soc/interconnect} 0x10000>;
			interconnect-names = "DDP_COMPONENT_OVL1_qos", "DDP_COMPONENT_RDMA0_hrt_qos", "l25_pdai_a0";
		};
		goodix_fp: fingerprint {
			compatible = "mediatek,goodix-fp";
		};
		disp_sec {
			compatible = "mediatek,disp_sec";
			sw_sync_token_tzmp_disp_wait = <0x28d>;
			sw_sync_token_tzmp_disp_set = <0x28e>;
			mboxes = <&{/soc/gce_mbox_sec@1e980000} &{/soc/syscon@1b200000} 0xffffffff &{/soc/power-controller@1c001000}>;
		};
	};

	lk_charger: lk_charger {
		compatible = "mediatek,lk_charger";
		enable_anime;
		/* enable_pe_plus; */
		enable_pd20_reset;
		power_path_support;
		max_charger_voltage = <6500000>;
		fast_charge_voltage = <3000000>;

		/* charging current */
		usb_charger_current = <500000>;
		ac_charger_current = <2050000>;
		ac_charger_input_current = <3200000>;
		non_std_ac_charger_current = <500000>;
		charging_host_charger_current = <1500000>;
		ta_ac_charger_current = <3000000>;
		pd_charger_current = <500000>;

		/* battery temperature protection */
		temp_t4_threshold = <50>;
		temp_t3_threshold = <45>;
		temp_t1_threshold = <0>;

		/* enable check vsys voltage */
		enable_check_vsys;
	};

	pe: pe {
		compatible = "mediatek,charger,pe";
		gauge = <0x7c>;

		ta_12v_support;
		ta_9v_support;

		pe_ichg_level_threshold = <1000000>; /* uA */
		ta_start_battery_soc = <0>;
		ta_stop_battery_soc = <85>;
		min_charger_voltage = <4600000>;

		ta_ac_12v_input_current = <3200000>;
		ta_ac_9v_input_current = <3200000>;
		ta_ac_7v_input_current = <3200000>;
		pe_charger_current = <3000000>;
		vbat_threshold = <4150>;
	};

	pe2: pe2 {
		compatible = "mediatek,charger,pe2";
		gauge = <0x7c>;

		/* PE 2.0 */
		pe20_ichg_level_threshold = <1000000>; /* uA */
		ta_start_battery_soc = <0>;
		ta_stop_battery_soc = <85>;
		min_charger_voltage = <4600000>;

		/* cable measurement impedance */
		cable_imp_threshold = <699>;
		vbat_cable_imp_threshold = <3900000>; /* uV */

		/* single charger */
		sc_input_current = <3200000>;
		sc_charger_current = <3000000>;

		/* dual charger in series*/
		dcs_input_current = <3200000>;
		dcs_chg1_charger_current = <1500000>;
		dcs_chg2_charger_current = <1500000>;

		dual_polling_ieoc = <450000>;
		slave_mivr_diff = <100000>;
		vbat_threshold = <4150>;
	};

	pdc: pdc {
		compatible = "mediatek,charger,pd";
		gauge = <0x7c>;

		min_charger_voltage = <4600000>;
		pd_vbus_low_bound = <5000000>;
		pd_vbus_upper_bound = <5000000>;
		vsys_watt = <5000000>;
		ibus_err = <14>;

		pd_stop_battery_soc = <80>;

		/* single charger */
		sc_input_current = <3200000>;
		sc_charger_current = <3000000>;

		/* dual charger in series*/
		dcs_input_current = <3200000>;
		dcs_chg1_charger_current = <1500000>;
		dcs_chg2_charger_current = <1500000>;

		/* dual charger */
		dual_polling_ieoc = <450000>;
		slave_mivr_diff = <100000>;
		vbat_threshold = <4150>;
		enable-inductor-protect = <0x1>;
	};


	pe5: pe5 {
		compatible = "mediatek,charger,pe5";
		gauge = <0x7c>;
		polling_interval = <10000>;
		ta_cv_ss_repeat_tmin = <25>;
		vbat_cv = <4350>;
		start_soc_min = <0>;
		start_soc_max = <80>;
		start_vbat_max = <4300>;
		idvchg_term = <500>;
		idvchg_step = <50>;
		ita_level = <3000 2500 2000 1500>;
		rcable_level = <250 300 375 500>;
		ita_level_dual = <5000 3700 3400 3000>;
		rcable_level_dual = <230 350 450 550>;
		idvchg_ss_init = <1000>;
		idvchg_ss_step = <250>;
		idvchg_ss_step1 = <100>;
		idvchg_ss_step2 = <50>;
		idvchg_ss_step1_vbat = <4000>;
		idvchg_ss_step2_vbat = <4200>;
		ta_blanking = <400>;
		swchg_aicr = <0>;
		swchg_ichg = <1200>;
		swchg_aicr_ss_init = <400>;
		swchg_aicr_ss_step = <200>;
		swchg_off_vbat = <4250>;
		force_ta_cv_vbat = <4250>;
		chg_time_max = <5400>;
		tta_level_def = <0 0 0 0 25 50 60 70 80>;
		tta_curlmt = <0 0 0 0 0 300 600 900 (-1)>;
		tta_recovery_area = <3>;
		tbat_level_def = <0 0 0 5 25 40 43 46 50>;
		tbat_curlmt = <(-1) (-1) (-1) 300 0 600 900 1050 (-1)>;
		tbat_recovery_area = <3>;
		tdvchg_level_def = <0 0 0 5 25 55 60 65 70>;
		tdvchg_curlmt = <(-1) (-1) (-1) 300 0 300 600 900 (-1)>;
		tdvchg_recovery_area = <3>;
		tswchg_level_def = <0 0 0 5 25 65 70 75 80>;
		tswchg_curlmt = <(-1) (-1) (-1) 200 0 200 300 400 (-1)>;
		tswchg_recovery_area = <3>;
		ifod_threshold = <200>;
		rsw_min = <20>;
		ircmp_rbat = <40>;
		ircmp_vclamp = <0>;
		vta_cap_min = <6800>;
		vta_cap_max = <11000>;
		ita_cap_min = <1000>;
		support_ta = "pca_ta_pps", "pd_adapter";
		allow_not_check_ta_status;
		vbat_threshold = <4150>;
	};

	charger: charger {
		compatible = "mediatek,charger";
		gauge = <0x7c>;
		charger = <0x79>;
		bootmode = <0x76>;

		algorithm_name = "Basic";
		charger_configuration= <0>;

		/* common */
		battery_cv = <0x426030>;
		max_charger_voltage = <6500000>;
		min_charger_voltage = <4600000>;

		/* sw jeita */
		enable_vbat_mon= <1>;
		/* enable_sw_jeita; */
		jeita_temp_above_t4_cv = <4240000>;
		jeita_temp_t3_to_t4_cv = <4240000>;
		jeita_temp_t2_to_t3_cv = <4340000>;
		jeita_temp_t1_to_t2_cv = <4240000>;
		jeita_temp_t0_to_t1_cv = <4040000>;
		jeita_temp_below_t0_cv = <4040000>;
		temp_t4_thres = <50>;
		temp_t4_thres_minus_x_degree = <47>;
		temp_t3_thres = <45>;
		temp_t3_thres_minus_x_degree = <39>;
		temp_t2_thres = <10>;
		temp_t2_thres_plus_x_degree = <16>;
		temp_t1_thres = <0>;
		temp_t1_thres_plus_x_degree = <6>;
		temp_t0_thres = <0>;
		temp_t0_thres_plus_x_degree = <0>;
		temp_neg_10_thres = <0>;

		/* battery temperature protection */
		enable_min_charge_temp;
		min_charge_temp = <0x0>;
		min_charge_temp_plus_x_degree = <0x6>;
		max_charge_temp = <0x32>;
		max_charge_temp_minus_x_degree = <0x2f>;

		/* charging current */
		usb_charger_current = <500000>;
		ac_charger_current = <2050000>;
		ac_charger_input_current = <3200000>;
		charging_host_charger_current = <1500000>;

		/* dynamic mivr */
		enable_dynamic_mivr;
		min_charger_voltage_1 = <4400000>;
		min_charger_voltage_2 = <4200000>;
		max_dmivr_charger_current = <1800000>;

		/* fast charging algo support indicator */
		enable_fast_charging_indicator;
	};


	fm: fm@18000000 {
		compatible = "mediatek,fm";
		family-id = <0x6983>;
		host-id = <0x6895>;
		conn-id = <0x0205>;
		interrupts = <GIC_SPI 759 IRQ_TYPE_LEVEL_HIGH 0>;
	};

	connfem: connfem@18000000 {
		compatible = "mediatek,mt6895-connfem";
		pinctrl-1 = <&{/soc/pinctrl/wlan7207h_wf0} &{/soc/pinctrl/wlan7207h_wf1} &{/soc/pinctrl/wlan7205c_wf0} &{/soc/pinctrl/wlan7205c_wf1}>;
		pinctrl-2 = <&{/soc/pinctrl/qm42195_wf0} &{/soc/pinctrl/qm42195_wf1} &{/soc/pinctrl/qm45197_wf0} &{/soc/pinctrl/qm45197_wf1}>;
		pinctrl-0 = <&{/soc/pinctrl/wlan7207h_wf0} &{/soc/pinctrl/wlan7207h_wf1} &{/soc/pinctrl/wlan7207c_wf0} &{/soc/pinctrl/wlan7207c_wf1}>;
		pinctrl-3 = <&{/soc/pinctrl/qm42195_wf0} &{/soc/pinctrl/qm42195_wf1}>;
		pinctrl-names = "wlan7207h_wlan7207c", "wlan7207h_wlan7205c", "qm42195_qm45197", "qm42195_nofem";
	};

	btif: btif@1100c000 {
		compatible = "mediatek,btif";
		reg = <0x0 0x1100c000 0x0 0x100 0x0 0x11300b00 0x0 0x80 0x0 0x11300b80 0x0 0x80 0x0 0x11036014 0x0 0x4 0x0 0x11036300 0x0 0x4>;
				/*btif irq, IRQS_Sync ID, btif_irq_b*/
		interrupts = <GIC_SPI 202 IRQ_TYPE_LEVEL_HIGH 0>,
				/*btif tx dma irq*/
				<GIC_SPI 179 IRQ_TYPE_LEVEL_HIGH 0>,
				/*btif rx dma irq*/
				<GIC_SPI 180 IRQ_TYPE_LEVEL_HIGH 0>;
		clocks = <&pericfg_ao_clk CLK_PERAOP_0_BTIF>,
				/*btif clock*/
				<&pericfg_ao_clk CLK_PERAOP_1_DMA_BCLK>;
				/*ap dma clock*/
		clock-names = "btifc","apdmac";
	};

	consys: consys@18000000 {
		compatible = "mediatek,mt6895-consys";
		#thermal-sensor-cells = <0>;
		reg = <0 0x10001000 0 0xee4>, /* 0. 0x1000_1000 infracfg_ao */
			<0 0x10005000 0 0xa78>, /* 1. 0x1000_5000 GPIO */
			<0 0x11c30000 0 0xa14>, /* 2. 0x11c3_0000 IOCFG_RT */
			<0 0x11ea0000 0 0xa04>, /* 3. 0x11ea_0000 IOCFG_RTT */
			<0 0x18000000 0 0x470>, /* 4. 0x1800_0000 conn_infra_rgu_on */
			<0 0x18001000 0 0x658>, /* 5. 0x1800_1000 conn_infra_cfg_on */
			<0 0x18003000 0 0x204>, /* 6. 0x1800_3000 conn_wt_slp_ctl_reg */
			<0 0x1800e000 0 0x124>, /* 7. 0x1800_e000 conn_infra_bus_cr_on */
			<0 0x18011000 0 0x138>, /* 8. 0x1801_1000 conn_infra_cfg */
			<0 0x18012000 0 0x98>,  /* 9. 0x1801_2000 conn_infra_clkgen_top */
			<0 0x18020000 0 0x4c>,  /* 10. 0x1802_0000 conn_von_bus_bcrm */
			<0 0x18023000 0 0xe28>, /* 11. 0x1802_3000 conn_dbg_ctl */
			<0 0x1803b000 0 0x18>,  /* 12. 0x1803_b000 conn_infra_on_bus_bcrm */
			<0 0x18040000 0 0x2c>,  /* 13. 0x1804_0000 conn_therm_ctl */
			<0 0x18041000 0 0x128>, /* 14. 0x1804_1000 conn_afe_ctl */
			<0 0x18042000 0 0x324>, /* 15. 0x1804_2000 conn_rf_spi_mst_reg */
			<0 0x1804b000 0 0x414>, /* 16. 0x1804_b000 conn_infra_bus_cr */
			<0 0x1804d000 0 0x41c>, /* 17. 0x1804_d000 conn_infra_off_debug_ctrl_ao */
			<0 0x1804f000 0 0x148>, /* 18. 0x1804_f000 conn_infra_off_bus_bcrm */
			<0 0x18053800 0 0x1000>,/* 19. 0x1805_3800 conn_infra_sysram_sw_cr */
			<0 0x18060000 0 0xc08>, /* 20. 0x1806_0000 conn_host_csr_top */
			<0 0x18070000 0 0x8004>,/* 21. 0x1807_0000 conn_semaphore */
			<0 0x1c001000 0 0xfb0>, /* 22. 0x1c00_1000 spm */
			<0 0x1c007000 0 0x51c>; /* 23. 0x1c00_7000 top_rgu */
		power-domains = <&scpsys MT6895_POWER_DOMAIN_CONN>;
		emi-addr = <0>;
		emi-size = <0x7e0000>;
		emi-alignment = <0x100000>;
		emi-max-addr = <0x90000000>;
		tcxo_support = "false";
		scp-shm-addr = <0>;
		scp-shm-size = <0x20000>;
	};

	bt: bt@18000000 {
		compatible = "mediatek,bt";
		flavor_bin = "b";
			/* conn_infra_rgu */
		reg = <0 0x18000000 0 0x1000>,
			/* conn_infra_cfg */
			<0 0x18001000 0 0x1000>,
			/* sys ram */
			<0 0x18051000 0 0x1000>,
			/* conn_host_csr_top */
			<0 0x18060000 0 0x1000>,
			/* bgfsys base */
			<0 0x18800000 0 0x1000>,
			/* bgfsys hw info base */
			<0 0x18812000 0 0x1000>,
			/* coninfra cfg ao */
			<0 0x10001000 0 0x1000>;
			/* coninfra ccif base */
			/* <0 0x10003300 0 0x100>, */
			/* bgf2md base */
			/* <0 0x1025c000 0 0x100>; */
			/* Rx Interrupt */
		interrupts = <GIC_SPI 523 IRQ_TYPE_LEVEL_HIGH 0>,
			/* Assert & FW log interrupt */
			<GIC_SPI 538 IRQ_TYPE_LEVEL_HIGH 0>,
			<GIC_SPI 524 IRQ_TYPE_LEVEL_HIGH 0>;
	};

	wifi: wifi@18000000 {
		compatible = "mediatek,wifi";
		reg = <0 0x18000000 0 0x700000>;
		interrupts = <GIC_SPI 522 IRQ_TYPE_LEVEL_HIGH 0>,
			<GIC_SPI 537 IRQ_TYPE_LEVEL_HIGH 0>;
		flavor_bin = "b";
		emi-addr = <0>;
		emi-size = <0x1400000>;
		emi-alignment = <0x1000000>;
		emi-max-addr = <0xC0000000>;
	};

	extcon_usb: extcon_usb {
		compatible = "mediatek,extcon-usb";
		vbus-supply = <&{/soc/i2c@11280000/mt6375@34/chg/otg}>;
		vbus-voltage = <5000000>;
		vbus-current = <1800000>;
		charger = <0x79>;
		tcpc = "type_c_port0";
		mediatek,bypss-typec-sink = <1>;
		port {
			usb_role: endpoint@0 {
				remote-endpoint = <&{/soc/usb0@11201000/port/endpoint@0}>;
			};
		};
	};

	extcon_usb1: extcon_usb1 {
		compatible = "mediatek,extcon-usb";
		port {
			usb_role1: endpoint@0 {
				remote-endpoint = <&{/soc/usb1@11211000/port/endpoint@0}>;
			};
		};
	};

	gpu_protected_memory_allocator: protected-memory-allocator {
		compatible = "arm,protected-memory-allocator";
		reg = <0 0x13c40000 0 0x22000>;
		reg-names = "gpueb_base";
		gpr_offset = <0x1FD1C>;
		gpr_id = <6>;
		gmpu_table_size = <0x0>;
		protected_reserve_size = <0x400000>;
	};

	mali: mali@13000000 {
		compatible = "mediatek,mali", "arm,mali-valhall";
		reg = <0 0x13000000 0 0x480000>;
		interrupts =
			<GIC_SPI 512 IRQ_TYPE_LEVEL_HIGH 0>,
			<GIC_SPI 513 IRQ_TYPE_LEVEL_HIGH 0>,
			<GIC_SPI 514 IRQ_TYPE_LEVEL_HIGH 0>,
			<GIC_SPI 515 IRQ_TYPE_LEVEL_HIGH 0>,
			<GIC_SPI 516 IRQ_TYPE_LEVEL_HIGH 0>;
		interrupt-names =
			"GPU",
			"MMU",
			"JOB",
			"EVENT",
			"PWR";
		protected-memory-allocator = <0x116>;
		operating-points-v2 = <0x117>;
		#cooling-cells = <2>;
		ged-supply = <&{/ged}>;
	};

	camisp: camisp@1a000000 {
		compatible = "mediatek,camisp";
		reg = <0 0x1a000000 0 0x1000>;
		reg-names = "base";
		mediatek,ccd = <0x119>;
		power-domains = <&scpsys MT6895_POWER_DOMAIN_CAM_MAIN>;
		operating-points-v2 = <0x11a>;
		dvfs-vmm-supply = <&{/ispdvfs/vmm-proxy}>;
		mux_name = "cam";
		clk_src = "TOP_MAINPLL_D4_D2",
				"TOP_UNIVPLL_D4_D2", "TOP_UNIVPLL_D6",
				"TOP_MAINPLL_D4", "TOP_UNIVPLL_D4";
		clocks = <&topckgen_clk CLK_TOP_CAM_SEL>,	        /* 0 */
			 <&topckgen_clk CLK_TOP_MAINPLL_D4_D2>,	        /* 1 */
			 <&topckgen_clk CLK_TOP_UNIVPLL_D4_D2>,	        /* 2 */
			 <&topckgen_clk CLK_TOP_UNIVPLL_D6>,	        /* 3 */
			 <&topckgen_clk CLK_TOP_MAINPLL_D4>,	        /* 4 */
			 <&topckgen_clk CLK_TOP_UNIVPLL_D4>;	        /* 5 */
		clock-names = "cam",	                                /* 0 */
				"TOP_MAINPLL_D4_D2",	                /* 1 */
				"TOP_UNIVPLL_D4_D2",	                /* 2 */
				"TOP_UNIVPLL_D6",	                /* 3 */
				"TOP_MAINPLL_D4",	                /* 4 */
				"TOP_UNIVPLL_D4";	                /* 5 */
	};

	remoteproc_ccd: remoteproc_ccd@1a030000 {
		compatible = "mediatek,ccd";
		reg = <0 0x1a030000 0 0x10000>;
		dma-ranges = <0x0 0x0 0x0 0x0 0x4 0x0>;
		iommus = <&{/soc/iommu@1e810000} &{/soc/smi_pd_ipe} &{/soc/iommu@1e810000} &{/soc/smi_pd_cam_mraw} &{/soc/iommu@1e810000} &{/soc/smi_pd_cam_suba} &{/soc/iommu@1e810000} &{/soc/smi_pd_cam_subb} &{/soc/iommu@1e810000} &{/soc/smi_pd_cam_subc} &{/soc/iommu@1e810000} &{/soc/emislb@10342000} &{/soc/iommu@1e810000} &{/soc/dmaheap_test0} &{/soc/iommu@1e810000} &{/soc/dmaheap_test1} &{/soc/iommu@1e810000} &{/soc/opp-table-disp1} &{/soc/iommu@1e810000} &{/soc/ufshci@112b0000} &{/soc/iommu@1e810000} &{/soc/scp@1c700000} &{/soc/iommu@1e810000} &{/soc/disp_pwm0@1100e000} &{/soc/iommu@1e810000} &{/soc/disp_mutex@14001000} &{/soc/iommu@1e810000} &{/soc/disp_ovl@14002000} &{/soc/iommu@1e810000} &{/soc/disp_ovl@14003000} &{/soc/iommu@1e810000} &{/soc/disp_ovl@14004000} &{/soc/iommu@1e810000} &{/soc/disp_rsz0@14005000}>;
		msg_dev {
			mtk,rpmsg-name = "mtk_ccd_msgdev";
		};
	};

