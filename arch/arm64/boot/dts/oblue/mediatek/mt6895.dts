			compatible = "mediatek, apu_mem_data";

			status = "okay";
			type = <2>;
			mask = /bits/ 64 <0x00000003ffffffff>;
			dma-ranges = <0x0 0x0 0x0 0x0 0x4 0x0>;
			iommus = <&{/soc/iommu@19015000} 0x100442>;
		};

		mvpu {
			compatible = "mediatek, mt6895-mvpu";
			core_num = <1>;
			version = <0x0>;
			mask = /bits/ 64 <0x00000003ffffffff>;
			iommus = <&{/soc/iommu@19010000} 0x120441>;
