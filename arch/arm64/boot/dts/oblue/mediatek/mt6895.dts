			mdp_rdma0_rst_done = <CMDQ_EVENT_MDPSYS0_MDP_RDMA0_SW_RST_DONE_ENG_EVENT>;
			interconnects = <&{/soc/interconnect} 0x40040 &{/soc/interconnect} 0x10000 &{/soc/interconnect} 0x40041 &{/soc/interconnect} 0x10000 &{/soc/interconnect} 0x40042 &{/soc/interconnect} 0x10000 &{/soc/interconnect} 0x40043 &{/soc/interconnect} 0x10000>;
			interconnect-names =
