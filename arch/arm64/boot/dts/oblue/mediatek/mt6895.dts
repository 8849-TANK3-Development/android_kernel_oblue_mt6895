};

&mddriver {
	/* for md pmic voltage setting*/
	md_vmodem = <800000 800000>;
	md_vsram = <800000 800000>;
	md_vdigrf = <700000 700000>;
};

&md_auxadc {
};

&ispdvfs {
};

// load wifi firmware
&wifi {
};

