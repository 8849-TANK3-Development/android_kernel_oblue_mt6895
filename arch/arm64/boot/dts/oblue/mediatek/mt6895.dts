			wrot1 = <MML_WROT1 0 13>;
			dli_async0 = <MML_DLI0 0 16>;
			dli_async1 = <MML_DLI1 0 17>;
			dlo_async0 = <MML_DLO0 0 18>;
			dlo_async1 = <MML_DLO1 0 19>;
			rsz2 = <MML_RSZ2 0 20>;
			rsz3 = <MML_RSZ3 0 21>;
			wrot2 = <MML_WROT2 0 22>;
