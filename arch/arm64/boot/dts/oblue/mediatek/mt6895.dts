	gpufreq: gpufreq {
		compatible = "mediatek,gpufreq";
		reg = <0x0 0x13fa0000 0x0 0x400 0x0 0x13fa0c00 0x0 0x400 0x0 0x13fbf000 0x0 0x1000 0x0 0x13f90000 0x0 0x10000 0x0 0x1c001000 0x0 0x1000 0x0 0x10000000 0x0 0x1000 0x0 0x1021c000 0x0 0x1000 0x0 0x1021e000 0x0 0x1000 0x0 0x10270000 0x0 0x1000 0x0 0x1030e000 0x0 0x1000 0x0 0x10001000 0x0 0x1000 0x0 0x10023000 0x0 0x1000 0x0 0x1002b000 0x0 0x1000 0x0 0x10042000 0x0 0x1000 0x0 0x11f10000 0x0 0x1000 0x0 0x13fb9c00 0x0 0x100 0x0 0x13fb6000 0x0 0x1000 0x0 0x1000d000 0x0 0x1000>;
		reg-names = "mfg_pll", "mfgsc_pll", "mfg_top_config", "mfg_rpc", "sleep", "topckgen", "nth_emicfg_reg", "sth_emicfg_reg", "nth_emicfg_ao_mem_reg", "sth_emicfg_ao_mem_reg", "infracfg_ao", "infra_ao_debug_ctrl", "infra_ao1_debug_ctrl", "nth_emi_ao_debug_ctrl", "efuse", "mfg_cpe_control", "mfg_cpe_sensor", "drm_debug_base";
		power-domains =
			<&scpsys MT6895_POWER_DOMAIN_MFG1>,
			<&scpsys MT6895_POWER_DOMAIN_MFG2>,
			<&scpsys MT6895_POWER_DOMAIN_MFG3>,
			<&scpsys MT6895_POWER_DOMAIN_MFG4>,
			<&scpsys MT6895_POWER_DOMAIN_MFG5>,
			<&scpsys MT6895_POWER_DOMAIN_MFG6>,
			<&scpsys MT6895_POWER_DOMAIN_MFG7>,
			<&scpsys MT6895_POWER_DOMAIN_MFG8>,
			<&scpsys MT6895_POWER_DOMAIN_MFG9>,
			<&scpsys MT6895_POWER_DOMAIN_MFG10>,
			<&scpsys MT6895_POWER_DOMAIN_MFG11>,
			<&scpsys MT6895_POWER_DOMAIN_MFG12>;
		power-domain-names =
			"pd_mfg1",
			"pd_mfg2",
			"pd_mfg3",
			"pd_mfg4",
			"pd_mfg5",
			"pd_mfg6",
			"pd_mfg7",
			"pd_mfg8",
			"pd_mfg9",
			"pd_mfg10",
			"pd_mfg11",
			"pd_mfg12";
		_vcore-supply = <&{/spmi@1c804000/pmic@4/regulators/VBUCK2}>;
		_dvfsrc-supply = <&{/soc/dvfsrc@1c00f000/dvfsrc-vcore}>;
		_vstack-supply = <&{/spmi@1c804000/second_pmic@5/regulators/VBUCK2}>;
		_vsram-supply = <&{/spmi@1c804000/pmic@4/regulators/VBUCK4}>;
		nvmem-cells = <&{/efuse@11f10000/segment@78}>;
		nvmem-cell-names = "efuse_segment_cell";
		gpufreq_wrapper-supply = <&{/gpufreq_wrapper}>;
	};

	gpufreq_wrapper: gpufreq_wrapper {
		compatible = "mediatek,gpufreq_wrapper";
		gpufreq-version = <2>;
		dual-buck = <1>;
		gpueb-support = <1>;
	};

	ged: ged {
		compatible = "mediatek,ged";
		gpufreq-supply = <&{/gpufreq}>;
	};

	efuse: efuse@11f10000 {
		compatible = "mediatek,devinfo";
		reg = <0 0x11f10000 0 0x10000>;
		#address-cells = <1>;
		#size-cells = <1>;
		efuse_segment: segment@78 {
			reg = <0x78 0x4>;
		};

		lvts_e_data1: data1 {
			reg = <0x1d4 0xc>;
		};
		lvts_e_data2: data2 {
			reg = <0x2f8 0x50>;
		};
		lvts_e_data3: data3 {
			reg = <0x2d4 0x14>;
		};

		lkginfo: lkg {
			reg = <0x218 0x18>;
		};
		u2_phy_data: u2_phy_data {
			reg = <0x1b0 0x4>;
		};
	};

	lvts: lvts@10315000 {
		compatible = "mediatek,mt6895-lvts";
		#thermal-sensor-cells = <1>;
		reg = <0 0x10315000 0 0x1000>,
			  <0 0x10316000 0 0x1000>;
		interrupts = <GIC_SPI 213 IRQ_TYPE_LEVEL_HIGH 0>,
			<GIC_SPI 214 IRQ_TYPE_LEVEL_HIGH 0>;

		clocks = <&infracfg_ao_clk CLK_IFRAO_THERM>;
		clock-names = "lvts_clk";
		resets = <&{/soc/syscon@10001000/reset-controller} 0x0 &{/soc/syscon@10001000/reset-controller} &{/interrupt-controller}>;

		nvmem-cells = <&{/efuse@11f10000/data1} &{/efuse@11f10000/data2} &{/efuse@11f10000/data3}>;
		nvmem-cell-names = "e_data1","e_data2","e_data3";
	};

	tboard_thermistor1: thermal-ntc1 {
		compatible = "mediatek,mt6895-board-ntc";
		#thermal-sensor-cells = <0>;
