	seninf_top: seninf_top@1a010000 {
		compatible = "mediatek,seninf-core";
		reg = <0 0x1a010000 0 0x20000>,
			<0 0x11c80000 0 0x20000>;
		reg-names = "base", "ana-rx";
		seninf_num = <10>;
		mux_num = <17>;
		cam_mux_num = <23>;
		pref_mux_num = <13>;

		interrupts = <GIC_SPI 444 IRQ_TYPE_LEVEL_HIGH 0>;

		power-domains = <&scpsys MT6895_POWER_DOMAIN_ISP_MAIN>,
		<&scpsys MT6895_POWER_DOMAIN_CAM_MAIN>;

		operating-points-v2 = <0x11a>;
		dvfsrc-vmm-supply = <&{/ispdvfs/vmm-proxy}>;

		clocks =
			<&cam_main_r1a_clk CLK_CAM_MAIN_SENINF_CON>,
			 <&topckgen_clk CLK_TOP_SENINF_SEL>,
			 <&topckgen_clk CLK_TOP_SENINF1_SEL>,
			 <&topckgen_clk CLK_TOP_SENINF2_SEL>,
			 <&topckgen_clk CLK_TOP_SENINF3_SEL>,
			 <&topckgen_clk CLK_TOP_SENINF4_SEL>,
			 <&topckgen_clk CLK_TOP_CAMTM_SEL>;
		clock-names = "clk_cam_seninf",
			 "clk_top_seninf",
			 "clk_top_seninf1",
			 "clk_top_seninf2",
			 "clk_top_seninf3",
			 "clk_top_seninf4",
			 "clk_top_camtm";
	};
