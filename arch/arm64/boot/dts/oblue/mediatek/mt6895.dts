				"rsz0", "rsz1", "tdshp0", "tdshp1", "color0", "color1",
				"wrot0", "wrot1",
				"dli_async0", "dli_async1", "dlo_async0", "dlo_async1",
				"rsz2", "rsz3", "wrot2", "wrot3";
