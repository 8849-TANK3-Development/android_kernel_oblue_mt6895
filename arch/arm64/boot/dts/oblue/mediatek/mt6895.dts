		mmc1: mmc@11240000 {
			compatible = "mediatek,common-mmc-v2";
			reg = <0 0x11240000 0 0x1000>,
				  <0 0x11e70000 0 0x1000>;
			interrupts = <GIC_SPI 135 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&topckgen_clk CLK_TOP_MSDC30_1_SEL>,
				 <&pericfg_ao_clk CLK_PERAOP_1_MSDC1_HCLK>,
				 <&pericfg_ao_clk CLK_PERAOP_1_MSDC1>;
			clock-names = "source", "hclk", "source_cg";
			status = "disabled";
			pinctrl-0 = <&{/soc/pinctrl/mmc1default}>;
			vmmc-supply = <&{/spmi@1c804000/second_pmic@5/regulators/VMCH_EINT_HIGH}>;
			pinctrl-1 = <&{/soc/pinctrl/mmc1@0}>;
			vqmmc-supply = <&{/spmi@1c804000/second_pmic@5/regulators/VMC}>;
			interconnects = <&{/soc/dvfsrc@1c00f000} &{/soc/syscon@15620000} &{/soc/dvfsrc@1c00f000} 0x0>;
		};

