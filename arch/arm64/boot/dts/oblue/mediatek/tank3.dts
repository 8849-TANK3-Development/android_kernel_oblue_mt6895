		pinctrl-2 = <&lm3644_pins_hwen_low>;
		status = "okay";
		flash@0 {
			reg = <0x00>;
			type = <0x00>;
			ct = <0x00>;
			part = <0x00>;
			port@0 {
				fl_core_0: endpoint {
