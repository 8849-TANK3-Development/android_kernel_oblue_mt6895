/*
 * 8849 TANK3 series — DTBO overlay (tank3.dtbo)
 *
 * Built against mt6895.dtb (tank3.dtbo-base := mt6895.dtb).
 * 73 fragments restored from the factory dtbo partition.
 * 所有 fragment 只引用 mt6895.dtb 里已有的 label 或 target-path,
 * 不在 overlay 内部引用自己新增节点, 符合 Android dtbo 打包要求。
 *
 * 编译: dtc -@ -H epapr (见 Makefile 的 dtbo-/dtbo-base 规则)
 */
/dts-v1/;
/plugin/;



/* === fragment@0 (target &reserved_memory ) === */
&reserved_memory {
	tkcore_shared_mem {
		compatible = "trustkernel,shared_mem";
		size = <0x00 0x1000000>;
		alignment = <0x00 0x1000>;
		alloc-ranges = <0x00 0x40000000 0x00 0x80000000>;
	};
};

/* === fragment@1 (target &chosen ) === */
&chosen {
	bootargs_ext = "console=tty0 root=/dev/ram androidboot.hardware=mt6895";
};

/* === fragment@2 (target &odm ) === */
&odm {
	vibrator0: vibrator@0 {
		compatible = "mediatek,vibrator";
		vib_timer = <0x19>;
		vib_limit = <0x09>;
		vib_vol = <0x09>;
	};
};

/* === fragment@3 (target &mtk_leds ) === */
&mtk_leds {
	compatible = "mediatek,pwm-leds";
	backlight {
		pwms = <&disp_pwm 0x00 0x99d9>;
		led_mode = <0x05>;
		gate_enable = <0x00>;
		pwm_config = <0x00 0x01 0x00 0x00 0x00>;
	};
};

/* === fragment@4 (target &gate_ic ) === */
&gate_ic {
	status = "disable";
};

/* === fragment@5 (target &afe ) === */
&afe {
	pinctrl-names = "aud_clk_mosi_off", "aud_clk_mosi_on", "aud_dat_mosi_off", "aud_dat_mosi_on", "aud_dat_mosi_ch34_off", "aud_dat_mosi_ch34_on", "aud_dat_miso0_off", "aud_dat_miso0_on", "aud_dat_miso1_off", "aud_dat_miso1_on", "aud_dat_miso2_off", "aud_dat_miso2_on", "vow_dat_miso_off", "vow_dat_miso_on", "vow_clk_miso_off", "vow_clk_miso_on", "aud_gpio_i2s3_off", "aud_gpio_i2s3_on", "aud_gpio_i2s0_off", "aud_gpio_i2s0_on";
	pinctrl-0 = <&aud_clk_mosi_off>;
	pinctrl-1 = <&aud_clk_mosi_on>;
	pinctrl-2 = <&aud_dat_mosi_off>;
	pinctrl-3 = <&aud_dat_mosi_on>;
	pinctrl-4 = <&aud_dat_mosi_ch34_off>;
	pinctrl-5 = <&aud_dat_mosi_ch34_on>;
	pinctrl-6 = <&aud_dat_miso0_off>;
	pinctrl-7 = <&aud_dat_miso0_on>;
	pinctrl-8 = <&aud_dat_miso1_off>;
	pinctrl-9 = <&aud_dat_miso1_on>;
	pinctrl-10 = <&aud_dat_miso2_off>;
	pinctrl-11 = <&aud_dat_miso2_on>;
	pinctrl-12 = <&vow_dat_miso_off>;
	pinctrl-13 = <&vow_dat_miso_on>;
	pinctrl-14 = <&vow_clk_miso_off>;
	pinctrl-15 = <&vow_clk_miso_on>;
	pinctrl-16 = <&aud_gpio_i2s3_off>;
	pinctrl-17 = <&aud_gpio_i2s3_on>;
	pinctrl-18 = <&aud_gpio_i2s0_off>;
	pinctrl-19 = <&aud_gpio_i2s0_on>;
};

/* === fragment@6 (target &pio ) === */
&pio {
	aud_clk_mosi_off: aud_clk_mosi_off {
		pins_cmd1_dat {
			pinmux = <0xca00>;
		};
		pins_cmd2_dat {
			pinmux = <0xcb00>;
		};
	};
	aud_clk_mosi_on: aud_clk_mosi_on {
		pins_cmd1_dat {
			pinmux = <0xca01>;
		};
		pins_cmd2_dat {
			pinmux = <0xcb01>;
		};
	};
	aud_dat_mosi_off: aud_dat_mosi_off {
		pins_cmd1_dat {
			pinmux = <0xcc00>;
		};
		pins_cmd2_dat {
			pinmux = <0xcd00>;
		};
	};
	aud_dat_mosi_on: aud_dat_mosi_on {
		pins_cmd1_dat {
			pinmux = <0xcc01>;
		};
		pins_cmd2_dat {
			pinmux = <0xcd01>;
		};
	};
	aud_dat_mosi_ch34_off: aud_dat_mosi_ch34_off {
		pins_cmd1_dat {
			pinmux = <0xce00>;
		};
	};
	aud_dat_mosi_ch34_on: aud_dat_mosi_ch34_on {
		pins_cmd1_dat {
			pinmux = <0xce01>;
		};
	};
	aud_dat_miso0_off: aud_dat_miso0_off {
		pins_cmd1_dat {
			pinmux = <0xd100>;
		};
	};
	aud_dat_miso0_on: aud_dat_miso0_on {
		pins_cmd1_dat {
			pinmux = <0xd101>;
		};
	};
	aud_dat_miso1_off: aud_dat_miso1_off {
		pins_cmd1_dat {
			pinmux = <0xd200>;
		};
	};
	aud_dat_miso1_on: aud_dat_miso1_on {
		pins_cmd1_dat {
			pinmux = <0xd201>;
		};
	};
	aud_dat_miso2_off: aud_dat_miso2_off {
		pins_cmd1_dat {
			pinmux = <0xd300>;
		};
	};
	aud_dat_miso2_on: aud_dat_miso2_on {
		pins_cmd1_dat {
			pinmux = <0xd301>;
		};
	};
	vow_dat_miso_off: vow_dat_miso_off {
		pins_cmd1_dat {
			pinmux = <0xd100>;
		};
	};
	vow_dat_miso_on: vow_dat_miso_on {
		pins_cmd1_dat {
			pinmux = <0xd102>;
		};
	};
	vow_clk_miso_off: vow_clk_miso_off {
		pins_cmd1_dat {
			pinmux = <0xd200>;
		};
	};
	vow_clk_miso_on: vow_clk_miso_on {
		pins_cmd1_dat {
			pinmux = <0xd202>;
		};
	};
	aud_nle_mosi_off: aud_nle_mosi_off {
		pins_cmd1_dat {
			pinmux = <0xcf00>;
		};
		pins_cmd2_dat {
			pinmux = <0xd000>;
		};
	};
	aud_nle_mosi_on: aud_nle_mosi_on {
		pins_cmd1_dat {
			pinmux = <0xcf01>;
		};
		pins_cmd2_dat {
			pinmux = <0xd001>;
		};
	};
	aud_gpio_i2s0_off: aud_gpio_i2s0_off {
		pins_cmd1_dat {
			pinmux = <0x1700>;
		};
	};
	aud_gpio_i2s0_on: aud_gpio_i2s0_on {
		pins_cmd1_dat {
			pinmux = <0x1701>;
		};
	};
	aud_gpio_i2s3_off: aud_gpio_i2s3_off {
		pins_cmd1_dat {
			pinmux = <0x1500>;
		};
		pins_cmd2_dat {
			pinmux = <0x1600>;
		};
		pins_cmd3_dat {
			pinmux = <0x1800>;
		};
	};
	aud_gpio_i2s3_on: aud_gpio_i2s3_on {
		pins_cmd1_dat {
			pinmux = <0x1501>;
		};
		pins_cmd2_dat {
			pinmux = <0x1601>;
		};
		pins_cmd3_dat {
			pinmux = <0x1801>;
		};
	};
};

/* === fragment@7 (target &consys ) === */
&consys {
	tcxo_support = "false";
	pinctrl-names = "default", "conninfra_tcxo_set", "conninfra_tcxo_clr";
	pinctrl-0 = <&conninfra_pins_default>;
	pinctrl-1 = <&conninfra_pins_tcxo_set>;
	pinctrl-2 = <&conninfra_pins_tcxo_clr>;
	status = "okay";
};

/* === fragment@8 (target &pio ) === */
&pio {
	conninfra_pins_default: conninfra_pins_default {
	};
	conninfra_pins_tcxo_set: conninfra_tcxo_set@gpio {
		pins_cmd_dat {
			pinmux = <0x6c03>;
		};
	};
	conninfra_pins_tcxo_clr: conninfra_tcxo_clr@gpio {
		pins_cmd_dat {
			pinmux = <0x6c00>;
		};
	};
};

/* === fragment@9 (target &pio ) === */
&pio {
	gps_pins_default: gps_default {
	};
	gps_l1_lna_pins_ol: gps_l1_lna@0 {
		pins_cmd_dat {
			pinmux = <0x1000>;
		};
	};
	gps_l1_lna_pins_dsp_ctrl: gps_l1_lna@1 {
		pins_cmd_dat {
			pinmux = <0x1006>;
		};
	};
	gps_l1_lna_pins_oh: gps_l1_lna@2 {
		pins_cmd_dat {
			pinmux = <0x1000>;
		};
	};
	gps_l5_lna_pins_ol: gps_l5_lna@0 {
		pins_cmd_dat {
			pinmux = <0x1100>;
		};
	};
	gps_l5_lna_pins_dsp_ctrl: gps_l5_lna@1 {
		pins_cmd_dat {
			pinmux = <0x1106>;
		};
	};
	gps_l5_lna_pins_oh: gps_l5_lna@2 {
		pins_cmd_dat {
			pinmux = <0x1100>;
		};
	};
};

/* === fragment@10 (target &gps ) === */
&gps {
	pinctrl-names = "default", "gps_l1_lna_disable", "gps_l1_lna_dsp_ctrl", "gps_l1_lna_enable", "gps_l5_lna_disable", "gps_l5_lna_dsp_ctrl", "gps_l5_lna_enable";
	pinctrl-0 = <&gps_pins_default>;
	pinctrl-1 = <&gps_l1_lna_pins_ol>;
	pinctrl-2 = <&gps_l1_lna_pins_dsp_ctrl>;
	pinctrl-3 = <&gps_l1_lna_pins_oh>;
	pinctrl-4 = <&gps_l5_lna_pins_ol>;
	pinctrl-5 = <&gps_l5_lna_pins_dsp_ctrl>;
	pinctrl-6 = <&gps_l5_lna_pins_oh>;
	status = "okay";
};

/* === fragment@11 (target &connfem ) === */
&connfem {
	epa_elna_mtk {
		parts = <&nofem &nofem &wlan7207h &wlan7207c &wlan7207h &wlan7207c &wlan7207h &wlan7207c &wlan7207h &wlan7207c &wlan7207h &wlan7205c &wlan7207h &wlan7205c &wlan7207h &wlan7205c &wlan7207h &wlan7205c &qm42195 &qm45197 &qm42195 &qm45197 &qm42195 &qm45197 &qm42195 &qm45197>;
		wifi {
			flags-1 {
			};
			flags-2 {
			};
			flags-5 {
			};
			flags-6 {
			};
			flags-9 {
			};
			flags-10 {
			};
		};
		bt {
			flags-1 {
			};
			flags-2 {
			};
			flags-3 {
			};
			flags-4 {
			};
			flags-5 {
			};
			flags-6 {
			};
			flags-7 {
			};
			flags-8 {
			};
			flags-9 {
			};
			flags-10 {
			};
			flags-11 {
			};
			flags-12 {
			};
		};
	};
};

/* === fragment@12 (target &sound ) === */
&sound {
	mediatek,spk-i2s = <0x03 0x00>;
	mediatek,speaker-codec {
		sound-dai = <&aw883xx_smartpa>;
	};
};

/* === fragment@13 (target &pio ) === */
&pio {
	mtkfb_pins_lcd_bias_enp1: lcd_bias_enp1_gpio {
		pins_cmd_dat {
			pinmux = <0xbd00>;
			slew-rate = <0x01>;
		};
	};
	mtkfb_pins_lcd_bias_enp0: lcd_bias_enp0_gpio {
		pins_cmd_dat {
			pinmux = <0xbd00>;
			slew-rate = <0x01>;
		};
	};
	mtkfb_pins_lcd_bias_enn1: lcd_bias_enn1_gpio {
		pins_cmd_dat {
			pinmux = <0xc100>;
			slew-rate = <0x01>;
		};
	};
	mtkfb_pins_lcd_bias_enn0: lcd_bias_enn0_gpio {
		pins_cmd_dat {
			pinmux = <0xc100>;
			slew-rate = <0x01>;
		};
	};
	mtkfb_pins_lcm_rst_out1_gpio: lcm_rst_out1_gpio {
		pins_cmd_dat {
			pinmux = <0x2900>;
			slew-rate = <0x01>;
		};
	};
	mtkfb_pins_lcm_rst_out0_gpio: lcm_rst_out0_gpio {
		pins_cmd_dat {
			pinmux = <0x2900>;
			slew-rate = <0x01>;
		};
	};
	mtkfb_pins_lcm_dsi_te: lcm_dsi_te {
		pins_cmd_dat {
			pinmux = <0x2801>;
		};
	};
	mtkfb_pins_lcm_led_en1: lcm_led_en1_gpio {
		pins_cmd_dat {
			pinmux = <0xd700>;
			slew-rate = <0x01>;
		};
	};
	mtkfb_pins_lcm_led_en0: lcm_led_en0_gpio {
		pins_cmd_dat {
			pinmux = <0xd700>;
			slew-rate = <0x01>;
		};
	};
	mtkfb_io_lcm_led_en1: lcm_io_en1_gpio {
		pins_cmd_dat {
			pinmux = <0x6000>;
			slew-rate = <0x01>;
		};
	};
	mtkfb_io_lcm_led_en0: lcm_io_en0_gpio {
		pins_cmd_dat {
			pinmux = <0x6000>;
			slew-rate = <0x01>;
		};
	};
};

/* === fragment@14 (target &mtkfb ) === */
&mtkfb {
	pinctrl-names = "lcd_bias_enp1_gpio", "lcd_bias_enp0_gpio", "lcd_bias_enn1_gpio", "lcd_bias_enn0_gpio", "lcm_rst_out1_gpio", "lcm_rst_out0_gpio", "mode_te_te", "lcm_led_en1_gpio", "lcm_led_en0_gpio", "lcm_io_en1_gpio", "lcm_io_en0_gpio";
	pinctrl-0 = <&mtkfb_pins_lcd_bias_enp1>;
	pinctrl-1 = <&mtkfb_pins_lcd_bias_enp0>;
	pinctrl-2 = <&mtkfb_pins_lcd_bias_enn1>;
	pinctrl-3 = <&mtkfb_pins_lcd_bias_enn0>;
	pinctrl-4 = <&mtkfb_pins_lcm_rst_out1_gpio>;
	pinctrl-5 = <&mtkfb_pins_lcm_rst_out0_gpio>;
	pinctrl-6 = <&mtkfb_pins_lcm_dsi_te>;
	pinctrl-7 = <&mtkfb_pins_lcm_led_en1>;
	pinctrl-8 = <&mtkfb_pins_lcm_led_en0>;
	pinctrl-9 = <&mtkfb_io_lcm_led_en1>;
	pinctrl-10 = <&mtkfb_io_lcm_led_en0>;
	status = "okay";
};

/* === fragment@15 (target &dispsys_config ) === */
&dispsys_config {
	pinctrl-names = "lcm_rst_out1_gpio", "lcm_rst_out0_gpio", "mode_te_te";
	pinctrl-0 = <&mtkfb_pins_lcm_rst_out1_gpio>;
	pinctrl-1 = <&mtkfb_pins_lcm_rst_out0_gpio>;
	pinctrl-2 = <&mtkfb_pins_lcm_dsi_te>;
	status = "okay";
};

/* === fragment@16 (target &dsi0 ) === */
&dsi0 {
	status = "okay";
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	panel1@0 {
		compatible = "xingliang,ft8719,vdo";
		reg = <0x00>;
		pm-enable-gpios = <&pio 0xd7 0x00>;
		reset-gpios = <&pio 0x29 0x00>;
		lcm-en-gpios = <&pio 0x60 0x00>;
		bias-gpios = <&pio 0xc1 0x00 &pio 0xbd 0x00>;
		gate-ic = <0x00>;
		lcm_bias_n_gpios = <0xc1>;
		lcm_bias_p_gpios = <0xbd>;
		lcm_v18_en_gpios = <0x60>;
		tp_rst_gpios = <0x7f>;
		i2c_scl6_gpios = <0x1f>;
		i2c_sda6_gpios = <0x20>;
		pinctrl-names = "default";
		port {
			panel_in1: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
	panel2@0 {
		compatible = "truly,td4330,cmd";
		reg = <0x01>;
		pm-enable-gpios = <&pio 0xd7 0x00>;
		reset-gpios = <&pio 0x29 0x00>;
		gate-ic = <0x12df>;
		pinctrl-names = "default";
		port {
			panel_in2: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
	ports {
		port {
			dsi_out: endpoint {
				remote-endpoint = <&panel_in1>;
			};
		};
	};
};

/* === fragment@17 (target &spi3 ) === */
&spi3 {
	status = "okay";
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	fingerprint@0 {
		compatible = "mediatek,fingerprint";
		reg = <0x00>;
		spi-max-frequency = <0x7a1200>;
		fingerprint,touch-int-gpio = <&pio 0x88 0x00>;
		interrupt-parent = <&pio>;
		interrupts = <0x88 0x02>;
		status = "okay";
	};
};

/* === fragment@18 (target &i2c3 ) === */
&i2c3 {
	tms_nfc@28 {
		status = "okay";
		compatible = "tms,thn31";
		reg = <0x28>;
		tms,irq-gpio = <&pio 0x8f 0x00>;
		tms,ven-gpio = <&pio 0x68 0x00>;
		tms,fw-download-gpio = <&pio 0x67 0x00>;
		tms,download-gpio = <&pio 0x67 0x00>;
		tms,device-name = "tms_nfc";
		tms,device-count = <0x01>;
	};
};

/* === fragment@19 (target &mt6375_typec ) === */
&mt6375_typec {
	port {
		tcpc_typec_usb: endpoint@0 {
			remote-endpoint = <&ssusb_mux>;
		};
	};
};

/* === fragment@20 (target &mt6375_chg ) === */
&mt6375_chg {
	cv = <0x1162>;
	ieoc = <0x1f4>;
};

/* === fragment@21 (target &typec_mux_switch ) === */
&typec_mux_switch {
	port {
		ssusb_mux: endpoint@0 {
			remote-endpoint = <&tcpc_typec_usb>;
		};
	};
};

/* === fragment@22 (target &usb_dp_selector ) === */
&usb_dp_selector {
	status = "okay";
};

/* === fragment@23 (target &pdc ) === */
&pdc {
	pd_vbus_upper_bound = <0xb71b00>;
};

/* === fragment@24 (target &mmlsys_config ) === */
&mmlsys_config {
};

/* === fragment@25 (target &i2c0 ) === */
&i2c0 {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	clock-frequency = <0x61a80>;
	cap_touch@41 {
		compatible = "tchip,ilitek";
		touch,reset-gpio = <&pio 0x7f 0x00>;
		touch,irq-gpio = <&pio 0x87 0x00>;
		reg = <0x41>;
		status = "okay";
	};
};

/* === fragment@26 (target &i2c6 ) === */
&i2c6 {
	i2c_lcd_bias: i2c_lcd_bias@3e {
		compatible = "mediatek,i2c_lcd_bias";
		reg = <0x3e>;
		id = <0x06>;
		status = "okay";
	};
};

/* === fragment@27 (target &mmc1 ) === */
&mmc1 {
	cd-gpios = <&pio 0x0b 0x00>;
	vmmc-supply = <&mt6368_vmch_eint_low>;
};

/* === fragment@28 (target &i2c6 ) === */
&i2c6 {
	sh366003: sh366003@55 {
		compatible = "sh,sh366003";
		reg = <0x55>;
		battery_params,name = "sh366003";
		status = "okay";
	};
};

/* === fragment@29 (target &{/} ) === */
&{/} {
	compatible = "agold,hw_info";
	lcm_vio18_en = <0x60>;
	lcm_id_channel = <0x02>;
	panel-HX_ILI7807S = <0x384>;
	panel-HX_NT36672C = <0x4b0>;
};

/* === fragment@30 (target &{/} ) === */
&{/} {
	laser_ranging {
		compatible = "agold,laser_ranging";
		ps_en = <&pio 0xbe 0x00>;
		waken_gpio = <&pio 0x65 0x00>;
		agold_adc_check = <0x01>;
		agold_id_adc = <0x6a4 0x76c 0x320 0x3e8>;
		io-channels = <&pmic_adc 0x316>;
		io-channel-names = "agold_adc_id";
		status = "okay";
	};
	ir_light {
		compatible = "agold,ir_light";
		ir_light,pwr1-gpio = <&pio 0xb3 0x00>;
		ir_light,pwr2-gpio = <&pio 0xb3 0x00>;
		ir_light,en1-gpio = <&pio 0xb2 0x00>;
		ir_light,en2-gpio = <&pio 0xb1 0x00>;
		ir_light,ir_level = <0x28>;
		status = "okay";
	};
	camping_light {
		compatible = "agold,camping_light";
		camping_light,pwr-gpio = <&pio 0xb9 0x00>;
		camping_light_min_duty = <0x05>;
		pwm_ch = <0x02>;
		status = "okay";
	};
	redblue_led {
		compatible = "agold,redblue_led";
		redblue_led,red_en-gpio = <&pio 0x1a 0x00>;
		redblue_led,blue_en-gpio = <&pio 0x19 0x00>;
		status = "okay";
	};
	microarray_finger: microarray_finger {
		compatible = "mediatek,microarray_finger";
