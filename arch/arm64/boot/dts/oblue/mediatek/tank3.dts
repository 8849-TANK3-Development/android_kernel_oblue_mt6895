				};
			};
		};
		flash@1 {
			reg = <0x01>;
			type = <0x00>;
			ct = <0x01>;
			part = <0x00>;
			port@1 {
				fl_core_1: endpoint {
					remote-endpoint = <&flashlight_1>;
				};
			};
		};
	};
};

